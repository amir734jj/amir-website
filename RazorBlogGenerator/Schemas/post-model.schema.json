{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "PostModel",
  "definitions": {
    "ContentPage": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "template": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "vars": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "pdf": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/PdfOptions"
            }
          ]
        },
        "route": {
          "type": "string"
        }
      }
    },
    "PdfOptions": {
      "type": "object",
      "properties": {
        "output": {
          "type": "string"
        },
        "font_family": {
          "type": [
            "null",
            "string"
          ]
        },
        "font_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/definitions/ContentPage"
    },
    {
      "type": "object",
      "properties": {
        "published_on": {
          "type": "string"
        },
        "excerpt": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hidden": {
          "type": "boolean"
        },
        "rendered_html": {
          "type": "string"
        }
      }
    }
  ]
}