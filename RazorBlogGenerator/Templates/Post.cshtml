@inherits RazorLight.TemplatePage<RenderContext>
@using RazorBlogGenerator.Models
@model RenderContext
@{
    var post = (PostModel)Model.Page;
}

<article>
  <p class="text-muted small">@post.PublishedOn</p>
  <h2 class="display-6 fw-bold">@post.Title</h2>
  <p class="lead text-secondary">@post.Excerpt</p>
  @if (post.GithubUrl.Count > 0 || post.WebsiteUrl.Count > 0)
  {
    <div class="d-flex gap-2 mb-3">
      @foreach (var githubUrl in post.GithubUrl)
      {
        <a href="@githubUrl" target="_blank" rel="noopener" class="btn btn-outline-dark btn-sm">
          <i class="bi bi-github"></i> GitHub
        </a>
      }
      @foreach (var websiteUrl in post.WebsiteUrl)
      {
        <a href="@websiteUrl" target="_blank" rel="noopener" class="btn btn-outline-primary btn-sm">
          <i class="bi bi-globe"></i> Website
        </a>
      }
    </div>
  }
  @if (post.Tags.Count > 0)
  {
    <div class="mb-3">
      @foreach (var tag in post.Tags)
      {
        <span class="badge bg-secondary me-1">@tag</span>
      }
    </div>
  }
  <hr />
  <div>@Raw(post.RenderedHtml)</div>
</article>
