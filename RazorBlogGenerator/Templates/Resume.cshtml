@inherits RazorLight.TemplatePage<RenderContext>
@using RazorBlogGenerator.Models
@using RazorBlogGenerator.Models.CV
@model RenderContext
@{
  var cv = (ResumeModel)Model.Page;
  var addressBreak = cv.Contact.Address.IndexOf(", ", StringComparison.Ordinal);
}

<style>
  .cv-print { display: none; }
  @@page {
    size: letter portrait;
    margin: .48in .58in .5in;
    @@bottom-left { content: "Seyedamirhossein Hesamian"; color: #555; font-size: 7.5pt; }
    @@bottom-right { content: counter(page) " / " counter(pages); color: #555; font-size: 7.5pt; }
  }
  .cv-print { color: #111; font-size: 9.25pt; line-height: 1.24; }
  .cv-print * { box-sizing: border-box; }
  .cv-print a { color: inherit; text-decoration: none; }
  .cv-print p { margin: 0; }
  .cv-print-header { border-bottom: .7pt solid #555; margin-bottom: 11pt; padding-bottom: 7pt; }
  .cv-print-header h1 { font-size: 20pt; font-weight: 700; line-height: 1.05; margin: 0 0 4pt; }
  .cv-print-tagline { font-size: 9.5pt; font-style: italic; margin-bottom: 3pt !important; }
  .cv-print-contact { display: grid; grid-template-columns: 1fr 1fr; }
  .cv-print-contact-right { color: #333; text-align: right; }
  .cv-print-section { margin: 0 0 10pt; }
  .cv-print-section h2 { font-size: 10.5pt; font-variant: small-caps; margin: 0 0 5pt; text-transform: none; }
  .cv-print-entry { margin: 0 0 7pt; }
  .cv-print-entry p { margin: 0; }
  .cv-print-entry > p:first-child { break-after: avoid; font-weight: 700; }
  .cv-print-entry > p:nth-child(2) { break-after: avoid; font-style: italic; }
  .cv-print-indent { break-inside: avoid; margin-left: 14pt; }
  .cv-print-role { break-after: avoid; font-style: normal; font-weight: 700; margin-top: 4pt !important; }
  .cv-print ul { margin: 2.5pt 0 0 16pt; padding: 0; }
  .cv-print li { break-inside: avoid; margin: 0 0 1.5pt; padding-left: 2pt; }
  .cv-page-break { break-before: page; }
  @if (Model.IsPdf)
  {
    <text>.cv-print { display: block; } .cv-screen { display: none; }</text>
  }
</style>

<article class="cv-print" lang="en" aria-hidden="@(!Model.IsPdf)">
  <header class="cv-print-header">
    <h1>@cv.Name</h1>
    <p class="cv-print-tagline">@cv.Tagline</p>
    <div class="cv-print-contact">
      <div>
        @if (addressBreak >= 0)
        {
          <p>@cv.Contact.Address[..addressBreak]<br />@cv.Contact.Address[(addressBreak + 2)..]</p>
        }
        else
        {
          <p>@cv.Contact.Address</p>
        }
      </div>
      <div class="cv-print-contact-right">
        <p>E-mail: <a href="mailto:@cv.Contact.Email">@cv.Contact.Email</a></p>
        <p>GitHub: <a href="@cv.Contact.GithubUrl">@cv.Contact.GithubLabel</a></p>
        <p>LinkedIn: <a href="@cv.Contact.LinkedinUrl">@cv.Contact.LinkedinLabel</a></p>
        <p>Phone #: @cv.Contact.Phone</p>
      </div>
    </div>
  </header>

  <section class="cv-print-section">
    <h2>Education:</h2>
    @foreach (var item in cv.Education)
    {
      <div class="cv-print-entry cv-print-indent">
        <p>@item.School, @item.Location</p>
        <p>@item.Degree, @item.Period</p>
        @foreach (var detail in item.Details)
        {
          if (detail.StartsWith("Thesis title:") && !string.IsNullOrWhiteSpace(item.ThesisUrl))
          {
            <p><a href="@item.ThesisUrl">@detail</a></p>
          }
          else
          {
            <p>@detail</p>
          }
        }
      </div>
    }
  </section>

  <section class="cv-print-section">
    <h2>Technical Skills:</h2>
    <ul>
      @foreach (var skill in cv.Skills)
      {
        <li><strong>@skill.Category:</strong> @skill.Value</li>
      }
    </ul>
  </section>

  <section class="cv-print-section">
    <h2>Experience:</h2>
    @foreach (var item in cv.Experience)
    {
      <div class="cv-print-entry@(item.PageBreakBefore ? " cv-page-break" : "")">
        <p>@item.Company, @item.Location</p>
        <p>@item.Title, @item.Period</p>
        @foreach (var role in item.Roles)
        {
          <div class="@(role.PageBreakBefore ? "cv-page-break" : "")">
            @if (!string.IsNullOrWhiteSpace(role.Name))
            {
              <p class="cv-print-role">@role.Name @if (!string.IsNullOrWhiteSpace(role.Period)) { <text>(@role.Period)</text> }</p>
            }
            <ul>
              @foreach (var bullet in role.Bullets)
              {
                <li>@bullet</li>
              }
            </ul>
          </div>
        }
      </div>
    }
  </section>

  <section class="cv-print-section">
    <h2>Honors &amp; Awards:</h2>
    <ul>@foreach (var honor in cv.Honors) { <li>@honor</li> }</ul>
  </section>

  <section class="cv-print-section">
    <h2>Additional Activities:</h2>
    <ul>@foreach (var activity in cv.Activities) { <li>@activity</li> }</ul>
  </section>

  <section class="cv-print-section">
    <h2>Work Authorization:</h2>
    <ul><li>@cv.WorkAuthorization</li></ul>
  </section>
</article>

<div class="cv-screen">
<div class="bg-light border rounded-3 p-4 mb-4 cv-header">
  <div class="d-flex flex-wrap align-items-center gap-4">
    @if (!string.IsNullOrWhiteSpace(cv.ProfileImage))
    {
      <img src="@cv.ProfileImage" alt="@cv.Name" class="rounded-circle cv-profile-image" width="120" height="120" style="object-fit: cover;" />
    }
    <div>
      <p class="text-uppercase text-muted small fw-semibold mb-1">Software Engineer</p>
      <h1 class="display-5 fw-bold">@cv.Name</h1>
      <p class="lead text-secondary">@cv.Tagline</p>
    </div>
  </div>
  <div class="d-flex flex-wrap gap-3 mt-3">
    <span><i class="bi bi-geo-alt"></i> @cv.Contact.Address</span>
    <a href="mailto:@cv.Contact.Email"><i class="bi bi-envelope"></i> @cv.Contact.Email</a>
    <a href="@cv.Contact.GithubUrl" target="_blank" rel="noopener"><i class="bi bi-github"></i> @cv.Contact.GithubLabel</a>
    <a href="@cv.Contact.LinkedinUrl" target="_blank" rel="noopener"><i class="bi bi-linkedin"></i> @cv.Contact.LinkedinLabel</a>
    <a href="tel:@cv.Contact.Phone"><i class="bi bi-telephone"></i> @cv.Contact.Phone</a>
  </div>
</div>

<div class="card mb-4 cv-section">
  <div class="card-body">
    <h2 class="h6 text-uppercase text-primary fw-bold">Education</h2>
    @foreach (var item in cv.Education)
    {
      <div class="mb-3 cv-entry">
        <div class="d-flex justify-content-between flex-wrap">
          <strong>@item.School</strong>
          <span class="text-muted">@item.Period</span>
        </div>
        <p class="text-secondary mb-1">@item.Degree &middot; @item.Location</p>
        @if (item.Details.Count > 0)
        {
          <ul class="mb-0">
            @foreach (var d in item.Details) { <li>@d</li> }
          </ul>
        }
        @if (!string.IsNullOrWhiteSpace(item.ThesisUrl))
        {
          <a href="@item.ThesisUrl" target="_blank" rel="noopener" class="btn btn-outline-primary btn-sm mt-2 cv-thesis">
            <i class="bi bi-file-earmark-text"></i> Thesis
          </a>
        }
      </div>
    }
  </div>
</div>

<div class="card mb-4 cv-section">
  <div class="card-body">
    <h2 class="h6 text-uppercase text-primary fw-bold">Technical Skills</h2>
    @foreach (var s in cv.Skills)
    {
      <p class="mb-1"><strong>@s.Category:</strong> @s.Value</p>
    }
  </div>
</div>

<div class="card mb-4 cv-section" id="experience">
  <div class="card-body">
    <h2 class="h6 text-uppercase text-primary fw-bold">Experience</h2>
    @foreach (var item in cv.Experience)
    {
      <div class="mb-4 border-bottom pb-3 cv-entry">
        <div class="d-flex justify-content-between flex-wrap">
          <strong>@item.Company</strong>
          <span class="text-muted">@item.Period</span>
        </div>
        <p class="text-secondary mb-2">@item.Title &middot; @item.Location</p>
        @foreach (var role in item.Roles)
        {
          @if (!string.IsNullOrWhiteSpace(role.Name))
          {
            <h3 class="h6 fw-semibold mb-1">@role.Name @if (!string.IsNullOrWhiteSpace(role.Period)) { <small class="text-muted fw-normal">@role.Period</small> }</h3>
          }
          <ul>
            @foreach (var b in role.Bullets) { <li>@b</li> }
          </ul>
        }
      </div>
    }
  </div>
</div>

<div class="row g-4 mb-4 cv-footer-sections">
  <div class="col-md-6">
    <div class="card h-100 cv-section">
      <div class="card-body">
        <h2 class="h6 text-uppercase text-primary fw-bold">Honors &amp; Awards</h2>
        <ul class="mb-0">@foreach (var h in cv.Honors) { <li>@h</li> }</ul>
      </div>
    </div>
  </div>
  <div class="col-md-6">
    <div class="card h-100 cv-section">
      <div class="card-body">
        <h2 class="h6 text-uppercase text-primary fw-bold">Additional Activities</h2>
        <ul>@foreach (var a in cv.Activities) { <li>@a</li> }</ul>
        <h2 class="h6 text-uppercase text-primary fw-bold mt-3">Work Authorization</h2>
        <p class="mb-0">@cv.WorkAuthorization</p>
      </div>
    </div>
  </div>
</div>
</div>
